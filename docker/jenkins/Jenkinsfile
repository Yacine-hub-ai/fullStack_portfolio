pipeline {

    agent any

    // ── Variables d'environnement ──────────────────────────────
    environment {
        BACKEND_IMAGE  = 'portfolio-backend'
        FRONTEND_IMAGE = 'portfolio-frontend'
        COMPOSE_FILE   = "docker/docker-compose.yml"
        TERRAFORM_DIR  = 'terraform/k8s-app'
        // ✅ KUBECONFIG pointe vers le fichier patché monté dans Jenkins
        KUBECONFIG     = '/var/jenkins_home/.kube/config'
        DOCKERHUB_USER = 'cineya'
        REPO_URL       = 'https://github.com/Yacine-hub-ai/fullStack_portfolio.git'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {

        // ── Stage 1 : Checkout ─────────────────────────────────
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${env.BRANCH_NAME ?: 'main'}"]],
                    userRemoteConfigs: [[
                        url: "${REPO_URL}",
                        credentialsId: 'github-token'
                    ]]
                ])
                script {
                    env.GIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                echo "✅ Checkout — branche: ${env.BRANCH_NAME ?: 'main'} | commit: ${env.GIT_SHORT}"
            }
        }

        // ── Stage 2 : Build ────────────────────────────────────
        stage('Build') {
            parallel {

                stage('Build Backend') {
                    steps {
                        sh """
                            docker build \\
                                --build-arg NODE_ENV=production \\
                                -t ${BACKEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT} \\
                                -t ${BACKEND_IMAGE}:latest \\
                                docker/backend/
                        """
                    }
                }

                stage('Build Frontend') {
                    steps {
                        sh """
                            docker build \\
                                -t ${FRONTEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT} \\
                                -t ${FRONTEND_IMAGE}:latest \\
                                -f docker/frontend/Dockerfile \\
                                .
                        """
                    }
                }
            }
        }

        // ── Stage 3 : SonarQube Analysis ───────────────────────
      stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('SonarQube') {
            sh """
                ${tool 'SonarScanner'}/bin/sonar-scanner \
                    -Dsonar.host.url=http://host.docker.internal:9000 \
                    -Dsonar.projectKey=portfolio-fullstack \
                    -Dsonar.sources=docker/backend \
                    -Dsonar.exclusions=**/node_modules/**,**/*.test.js,**/package-lock.json,**/*.js,**/*.ts \
                    -Dsonar.javascript.node.maxspace=2048 \
                    -Dsonar.javascript.environments=node
            """
        }
    }
}

      

        // ── Stage 5 : Push vers Docker Hub ─────────────────────
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_LOGIN',
                    passwordVariable: 'DOCKERHUB_PASSWORD'
                )]) {
                    sh """
                        echo \$DOCKERHUB_PASSWORD | docker login -u \$DOCKERHUB_LOGIN --password-stdin

                        docker tag ${BACKEND_IMAGE}:latest \$DOCKERHUB_LOGIN/${BACKEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT}
                        docker tag ${BACKEND_IMAGE}:latest \$DOCKERHUB_LOGIN/${BACKEND_IMAGE}:latest
                        docker push \$DOCKERHUB_LOGIN/${BACKEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT}
                        docker push \$DOCKERHUB_LOGIN/${BACKEND_IMAGE}:latest

                        docker tag ${FRONTEND_IMAGE}:latest \$DOCKERHUB_LOGIN/${FRONTEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT}
                        docker tag ${FRONTEND_IMAGE}:latest \$DOCKERHUB_LOGIN/${FRONTEND_IMAGE}:latest
                        docker push \$DOCKERHUB_LOGIN/${FRONTEND_IMAGE}:${BUILD_NUMBER}-${GIT_SHORT}
                        docker push \$DOCKERHUB_LOGIN/${FRONTEND_IMAGE}:latest

                        docker logout
                    """
                }
                echo "✅ Images poussées — tags: latest + ${BUILD_NUMBER}-${GIT_SHORT}"
            }
        }

        // ── Stage 6 : Déploiement Kubernetes avec Terraform ────
        stage('Deploy with Terraform') {
            steps {
                withCredentials([
                    string(credentialsId: 'mongo-root-user',     variable: 'MONGO_ROOT_USER'),
                    string(credentialsId: 'mongo-root-password', variable: 'MONGO_ROOT_PASSWORD'),
                    string(credentialsId: 'mongo-db',            variable: 'MONGO_DB_NAME')
                ]) {
                    // ✅ Capturer les variables Groovy AVANT le bloc sh pour éviter
                    //    l'interpolation Groovy des credentials dans le shell script
                    script {
                        def kubeconfig    = env.KUBECONFIG
                        def workspace     = env.WORKSPACE
                        def terraformDir  = env.TERRAFORM_DIR
                        def kubeContext   = 'docker-desktop'
                        def frontendImg   = "${env.DOCKERHUB_USER}/${env.FRONTEND_IMAGE}:${env.BUILD_NUMBER}-${env.GIT_SHORT}"
                        def backendImg    = "${env.DOCKERHUB_USER}/${env.BACKEND_IMAGE}:${env.BUILD_NUMBER}-${env.GIT_SHORT}"

                        sh '''
                            # ── Vérifier que kubectl fonctionne ──
                            echo "🔍 Vérification connexion Kubernetes..."
                            kubectl get nodes
                            echo "✅ Connexion Kubernetes OK"
                        '''

                        // ✅ Utiliser withEnv pour passer les valeurs sans interpolation Groovy
                        //    Les credentials ($MONGO_ROOT_USER etc.) restent dans l'env shell
                        //    et ne sont jamais interpolés par Groovy
                        withEnv([
                            "TF_KUBECONFIG=${kubeconfig}",
                            "TF_WORKSPACE=${workspace}",
                            "TF_DIR=${terraformDir}",
                            "TF_KUBE_CONTEXT=${kubeContext}",
                            "TF_FRONTEND_IMAGE=${frontendImg}",
                            "TF_BACKEND_IMAGE=${backendImg}"
                        ]) {
                            sh '''
                                # ── Initialiser Terraform ──
                                export KUBECONFIG="$TF_KUBECONFIG"
                                cd "$TF_WORKSPACE/$TF_DIR"

                                terraform init -input=false -upgrade
                                terraform fmt -check || true
                                terraform validate

                                # ── Supprimer le namespace si existant ──
                                kubectl delete namespace portfolio --ignore-not-found=true
                                if kubectl get namespace portfolio >/dev/null 2>&1; then
                                    echo "⏳ Attente suppression namespace..."
                                    kubectl wait --for=delete namespace/portfolio --timeout=180s
                                fi
                                echo "✅ Namespace prêt"

                                # ── Appliquer le plan Terraform ──
                                # ✅ Les variables sensibles ($MONGO_ROOT_USER etc.) sont lues
                                #    depuis l'environnement shell — jamais interpolées par Groovy
                                terraform apply -auto-approve \
                                    -var="kubeconfig_path=$TF_KUBECONFIG" \
                                    -var="kube_context=$TF_KUBE_CONTEXT" \
                                    -var="frontend_image=$TF_FRONTEND_IMAGE" \
                                    -var="backend_image=$TF_BACKEND_IMAGE" \
                                    -var="mongo_root_user=$MONGO_ROOT_USER" \
                                    -var="mongo_root_password=$MONGO_ROOT_PASSWORD" \
                                    -var="mongo_database=$MONGO_DB_NAME"

                                echo "✅ Terraform apply terminé"
                            '''
                        }
                    }
                }
            }
        }

        // ── Stage 7 : Health Check Kubernetes ──────────────────
        stage('Kubernetes Health Check') {
            steps {
                sh """
                    echo "⏳ Attente déploiements..."
                    kubectl rollout status deployment/frontend  -n portfolio --timeout=180s
                    kubectl rollout status deployment/backend   -n portfolio --timeout=180s
                    kubectl rollout status statefulset/mongodb  -n portfolio --timeout=180s

                    echo ""
                    echo "📦 Ressources Kubernetes :"
                    kubectl get all -n portfolio
                    echo ""
                    echo "🌐 Ingress :"
                    kubectl get ingress -n portfolio
                    echo ""
                    echo "✅ Application déployée avec succès !"
                """
            }
        }

    }

    // ── Post-actions ───────────────────────────────────────────
    post {
        success {
            echo "✅ Pipeline SUCCESS — Build #${BUILD_NUMBER} (${GIT_SHORT ?: 'N/A'})"
            emailext(
                to: 'nyacine183@gmail.com',
                subject: "✅ [Jenkins] portfolio-pipeline #${BUILD_NUMBER} — SUCCESS",
                body: """Build #${BUILD_NUMBER} terminé avec succès.

Commit  : ${GIT_SHORT ?: 'N/A'}
Branche : ${env.BRANCH_NAME ?: 'main'}
Durée   : ${currentBuild.durationString}

Images Docker Hub :
  - cineya/portfolio-backend:${BUILD_NUMBER}-${GIT_SHORT ?: 'N/A'}
  - cineya/portfolio-frontend:${BUILD_NUMBER}-${GIT_SHORT ?: 'N/A'}

Voir le build : ${env.BUILD_URL}"""
            )
        }
        failure {
            echo "❌ Pipeline FAILURE — Build #${BUILD_NUMBER}"
            sh "kubectl get pods -n portfolio || true"
            sh "kubectl describe pods -n portfolio || true"
            emailext(
                to: 'nyacine183@gmail.com',
                subject: "❌ [Jenkins] portfolio-pipeline #${BUILD_NUMBER} — FAILURE",
                body: """Build #${BUILD_NUMBER} a échoué.

Commit  : ${GIT_SHORT ?: 'N/A'}
Branche : ${env.BRANCH_NAME ?: 'main'}

Voir les logs : ${env.BUILD_URL}console"""
            )
        }
        always {
            sh "docker image prune -f || true"
            cleanWs()
        }
    }

}